<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.gonzalo.neolauncher"
    android:versionCode="4"
    android:versionName="4.0">
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- flecha del puntero de NEO Remote -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- solo para el puerto local 127.0.0.1:47800 por donde llega la posición de la flecha -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application
        android:label="Neo"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
        android:allowBackup="false">
        <!-- Pantalla de inicio estilo Apple TV -->
        <activity
            android:name=".HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Enciende la pantalla; la usa NEO Remote para prender la TV rápido.
             Los tres componentes siguientes se abren desde ADB (shell tiene DUMP); las apps comunes no pueden. -->
        <activity
            android:name=".WakeActivity"
            android:exported="true"
            android:permission="android.permission.DUMP"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar" />
        <!-- Dibuja la flecha del puntero; la arranca NEO Remote -->
        <service
            android:name=".CursorService"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- Control desde el celular (iPhone): página web en el puerto 8686 -->
        <service
            android:name=".WebRemoteService"
            android:exported="true"
            android:permission="android.permission.DUMP" />
        <!-- NEO clásico (NEXUS, MÓDULOS...), se abre desde las opciones -->
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:screenOrientation="landscape" />
    </application>
</manifest>
